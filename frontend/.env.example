# Copy to frontend/.env.local for local overrides. Only VITE_* values reach the browser — never put secrets here.

# Base path or URL of the API. Keep the default in development so requests go through the Vite proxy.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api requests (dev server only, not exposed to the browser).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
