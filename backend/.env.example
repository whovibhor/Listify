# Copy to backend/.env and fill in real values. Never commit backend/.env.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# MySQL 8.4 (WAMP: localhost:3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=listify
DB_TEST_NAME=listify_test
DB_USER=listify_app
DB_PASSWORD=
# Connections per server process. Their total must stay at 40 or more (ADR-031), and
# server processes x that total must stay under MySQL's max_connections.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10
# Requests let in at once per server process, and how long the rest may wait (ADR-032).
MAX_CONCURRENT_REQUESTS=35
REQUEST_WAIT_SECONDS=30

# Comma-separated list of browser origins allowed to call the API with credentials
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Random value, at least 32 characters in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-in-local-env

# console (dev: emails are written to the log) | smtp (configured in a later milestone)
MAIL_BACKEND=console

# Public URL of the frontend, used in password-reset links
FRONTEND_BASE_URL=http://localhost:5173

# Session lifetime (minutes): idle timeout and absolute maximum
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_MINUTES=10080
PASSWORD_RESET_TTL_MINUTES=60

# Where task attachments are saved; defaults to backend/storage. Use an absolute path.
# Back this folder up together with the database.
# STORAGE_DIR=
